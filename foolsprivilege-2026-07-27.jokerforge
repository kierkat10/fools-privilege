{
  "metadata": {
    "id": "foolsprivilege",
    "name": "Fool's Privilege",
    "author": [
      "Niicotino"
    ],
    "description": "Fool's Privilege is a Vanilla centered mod made with the goal of expanding base game, maintaining the core balance while also adding fun and original ideas. Over 100 New Jokers and more to come! Started by Niicotino.\n\nCurrent Status:\n\nTotal Jokers: 98\n\nUnique Art: 21/98\n\nNote: The art is currently in a development state. Every time new art is added, the number will be updated as well as the version.\n\nIt adds over 98 types of jokers, with new content besides jokers planned in the future.\n\nCREDITS\nArt done by: @DuplexME, @Pitiçaria_2, @Muddz, @Rvol65, @jandom++⁴⁵ and @SmoliconBoi on Discord.",
    "prefix": "foolspri",
    "main_file": "main.lua",
    "version": "0.1.0~beta",
    "priority": 0,
    "badge_colour": "005073",
    "badge_text_colour": "FFFFFF",
    "display_name": "Fool's Privilege",
    "dependencies": [
      "Steamodded (>=1.0.0~BETA-0827c)"
    ],
    "conflicts": [],
    "provides": [],
    "disable_vanilla": false,
    "iconImage": "data:image/png;base64,",
    "hasUserUploadedIcon": true
  },
